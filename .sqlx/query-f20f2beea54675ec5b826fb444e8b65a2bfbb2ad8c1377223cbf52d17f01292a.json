  "query": "\n        INSERT INTO asignaciones_llave (llave_id, empleado_id)\n        SELECT id, $2::uuid\n        FROM llaves_nfc\n        WHERE uid = $1 AND estado = 'inventario'\n        RETURNING id, llave_id, empleado_id, asignada_en, devuelta_en,\n                  motivo_devolucion, creado_en\n        ",
